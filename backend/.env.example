# ============================================================
#  时间树洞 · 后端环境变量
#  复制此文件为 .env 并填入实际值
#  cp .env.example .env
# ============================================================

# 服务器端口
PORT=3000

# 运行环境: production | development
NODE_ENV=production

# 服务器域名（用于 CORS 白名单和通知链接）
DOMAIN=api.timetreehole.com

# Apple App Store Connect 共享密钥（IAP 收据验证必须）
# 获取路径: App Store Connect → 用户和访问 → 共享密钥
APPLE_SHARED_SECRET=your_apple_shared_secret_here

# Apple IAP 环境: production | sandbox
# 上线后改为 production
APPLE_IAP_ENV=production

# APNs 推送密钥 ID（Apple Developer → Keys）
APNS_KEY_ID=YOUR_KEY_ID

# APNs 推送 Team ID（Apple Developer → Membership）
APNS_TEAM_ID=YOUR_TEAM_ID

# APNs 推送主题（Bundle ID）
APNS_TOPIC=com.yourcompany.timetreehole

# 数据库路径（Docker 部署无需修改）
DB_PATH=/app/data/timetreehole.db

# 上传文件目录（Docker 部署无需修改）
UPLOADS_DIR=/app/uploads

# 音频文件大小限制（MB）
MAX_FILE_SIZE_MB=20
