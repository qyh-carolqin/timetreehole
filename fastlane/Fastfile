# ============================================================
#  Fastlane 配置 — 时间树洞 iOS
#  自动管理证书 + 描述文件 + 构建 + TestFlight 上传
# ============================================================

default_platform(:ios)

# API Key 认证 (从环境变量读取)
# 注意: fastlane 的 api_key 哈希用 :key 承载 .p8 内容 (:key_content / :key_filepath 为兼容别名)
def api_key_params
  {
    key_id: ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key: ENV["APP_STORE_CONNECT_KEY"],
    key_content: ENV["APP_STORE_CONNECT_KEY"],
    # 普通 App Store 团队 (非企业版) — 不设置 cert 会无法判断团队类型而崩溃
    in_house: false
  }
end

# 定位 Xcode 内的 transporter 目录 (App Store 上传工具)
# Xcode 11+ 移除了 Application Loader, transporter 改到 Transporter.app 内;
# fastlane 2.237 在 Xcode 26 下按老的 Application Loader 路径探测失败。
# 关键: FASTLANE_ITUNES_TRANSPORTER_PATH 必须指向【目录】(fastlane 会 Dir.chdir 进去再执行
# iTMSTransporter), 传二进制文件本身会触发 Dir.chdir 报 ENOTDIR。
# 返回值: { dir: 目录路径, use_shell: 是否用 .cmd shell 脚本执行器(自带 classpath 装配) }
def find_transporter
  dev_dir = `xcode-select -p`.strip
  return nil if dev_dir.empty?

  candidates = []

  # 1) xcrun 解析出的二进制所在目录 (Xcode 26 下通常是 /Applications/Xcode-XX.app/Contents/Developer/usr/bin)
  begin
    r = `xcrun --find iTMSTransporter`.strip
    candidates << File.dirname(r) unless r.empty?
  rescue
    # ignore
  end

  # 2) Transporter.app 内的已知位置 (兼容 Xcode 15/16; itms/bin 含完整 Java 环境与 .cmd 脚本)
  base = File.join(dev_dir, "Applications/Transporter.app/Contents")
  candidates += [
    File.join(base, "itms/bin"),
    File.join(base, "MacOS")
  ]

  candidates.each do |dir|
    next unless File.directory?(dir)
    # 优先用 .cmd 脚本 (自带 classpath 装配, 最稳); 否则用二进制
    if File.exist?(File.join(dir, "iTMSTransporter.cmd"))
      return { dir: dir, use_shell: true }
    elsif File.exist?(File.join(dir, "iTMSTransporter"))
      return { dir: dir, use_shell: false }
    end
  end
  nil
end

platform :ios do

  desc "构建并上传 TestFlight"
  lane :beta do
    # 1. 创建/获取 Apple Distribution 证书
    cert(
      development: false,
      platform: "ios",
      api_key: api_key_params
    )

    # 2. 创建/获取 App Store 描述文件 (默认即 App Store 发布描述文件, 不传 adhoc/development)
    sigh(
      force: true,
      app_identifier: "com.carolqin.timetreehole",
      platform: "ios",
      api_key: api_key_params
    )

    # 2.5 把 sigh 真实生成的 profile 名写回 Xcode 工程
    #     解决: 门户里干净名字 "com.carolqin.timetreehole AppStore" 被孤儿 profile 占用,
    #     sigh 被迫生成带时间戳的名字(如 "...AppStore 1786272031"), 与 project.yml 写死的
    #     PROVISIONING_PROFILE_SPECIFIER 不匹配导致 gym archive 报 "No profile ... found"。
    #     这里用 SIGH_NAME 环境变量(由 sigh 设置)动态覆盖 Release 配置的 specifier, 一劳永逸。
    update_code_signing_settings(
      path: "TimeTreehole/TimeTreehole.xcodeproj",
      use_automatic_signing: false,
      profile_name: ENV["SIGH_NAME"],
      code_sign_identity: "Apple Distribution",
      targets: ["TimeTreehole"],
      build_configurations: ["Release"]
    )

    # 3. 编译构建
    gym(
      project: "TimeTreehole/TimeTreehole.xcodeproj",
      scheme: "TimeTreehole",
      configuration: "Release",
      export_method: "app-store",
      include_symbols: true,
      include_bitcode: false,
      output_directory: "build",
      output_name: "TimeTreehole.ipa",
      clean: true
    )

    # 4. 上传到 TestFlight
    #    手动定位 transporter 目录, 规避 Xcode 26 下 fastlane 探测失败
    #    (FASTLANE_ITUNES_TRANSPORTER_PATH 必须是目录, 否则 Dir.chdir 报 ENOTDIR)
    t = find_transporter
    if t
      ENV["FASTLANE_ITUNES_TRANSPORTER_PATH"] = t[:dir]
      if t[:use_shell]
        ENV["FASTLANE_ITUNES_TRANSPORTER_USE_SHELL_SCRIPT"] = "1"
      else
        ENV.delete("FASTLANE_ITUNES_TRANSPORTER_USE_SHELL_SCRIPT")
      end
      UI.message("✅ 使用 transporter 目录: #{t[:dir]} (shell 脚本=#{t[:use_shell]})")
    else
      UI.important("⚠️ 未能定位 iTMSTransporter 目录, 上传步骤可能失败 (可尝试在 codemagic.yaml 将 xcode 固定为稳定版)")
    end

    upload_to_testflight(
      api_key: api_key_params,
      ipa: "build/TimeTreehole.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

end
