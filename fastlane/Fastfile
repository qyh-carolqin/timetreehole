# ============================================================
#  Fastlane 配置 — 时间树洞 iOS
#  自动管理证书 + 描述文件 + 构建 + TestFlight 上传
# ============================================================

default_platform(:ios)

# API Key 认证 (从环境变量读取)
# 注意: fastlane 的 api_key 哈希用 :key 承载 .p8 内容 (:key_content / :key_filepath 为兼容别名)
def api_key_params
  {
    key_id: ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key: ENV["APP_STORE_CONNECT_KEY"],
    key_content: ENV["APP_STORE_CONNECT_KEY"],
    # 普通 App Store 团队 (非企业版) — 不设置 cert 会无法判断团队类型而崩溃
    in_house: false
  }
end

# 定位 Xcode 内的 transporter (App Store 上传工具)
# Xcode 11+ 移除了 Application Loader, transporter 改到 Transporter.app 内;
# 部分 fastlane 版本/部分 Xcode 版本探测失败, 这里手动定位并强制指定路径,
# 否则 upload_to_testflight 报 "Could not find transporter at .../Contents/Developer/."
def find_transporter
  dev_dir = `xcode-select -p`.strip
  return nil if dev_dir.empty?

  # 1) 优先用 xcrun (跟随当前 xcode-select 选中的 Xcode)
  begin
    r = `xcrun --find iTMSTransporter`.strip
    return r unless r.empty?
  rescue
    # ignore
  end

  # 2) 兜底: 直接拼 Transporter.app 内的已知位置 (兼容 Xcode 15/16/26)
  base = File.join(dev_dir, "Applications/Transporter.app/Contents")
  candidates = [
    File.join(base, "itms/bin/iTMSTransporter"),
    File.join(base, "MacOS/transporter"),
    File.join(base, "MacOS/iTMSTransporter")
  ]
  candidates.each { |c| return c if File.exist?(c) }
  nil
end

platform :ios do

  desc "构建并上传 TestFlight"
  lane :beta do
    # 1. 创建/获取 Apple Distribution 证书
    cert(
      development: false,
      platform: "ios",
      api_key: api_key_params
    )

    # 2. 创建/获取 App Store 描述文件 (默认即 App Store 发布描述文件, 不传 adhoc/development)
    sigh(
      force: true,
      app_identifier: "com.carolqin.timetreehole",
      platform: "ios",
      api_key: api_key_params
    )

    # 2.5 把 sigh 真实生成的 profile 名写回 Xcode 工程
    #     解决: 门户里干净名字 "com.carolqin.timetreehole AppStore" 被孤儿 profile 占用,
    #     sigh 被迫生成带时间戳的名字(如 "...AppStore 1786272031"), 与 project.yml 写死的
    #     PROVISIONING_PROFILE_SPECIFIER 不匹配导致 gym archive 报 "No profile ... found"。
    #     这里用 SIGH_NAME 环境变量(由 sigh 设置)动态覆盖 Release 配置的 specifier, 一劳永逸。
    update_code_signing_settings(
      path: "TimeTreehole/TimeTreehole.xcodeproj",
      use_automatic_signing: false,
      profile_name: ENV["SIGH_NAME"],
      code_sign_identity: "Apple Distribution",
      targets: ["TimeTreehole"],
      build_configurations: ["Release"]
    )

    # 3. 编译构建
    gym(
      project: "TimeTreehole/TimeTreehole.xcodeproj",
      scheme: "TimeTreehole",
      configuration: "Release",
      export_method: "app-store",
      include_symbols: true,
      include_bitcode: false,
      output_directory: "build",
      output_name: "TimeTreehole.ipa",
      clean: true
    )

    # 4. 上传到 TestFlight
    #    手动定位 transporter, 规避 Xcode 26 下 fastlane 探测失败
    transporter = find_transporter
    if transporter && !transporter.empty?
      ENV["FASTLANE_ITUNES_TRANSPORTER_PATH"] = transporter
      UI.message("✅ 使用 transporter: #{transporter}")
    else
      UI.important("⚠️ 未能定位 iTMSTransporter, 上传步骤可能失败 (可尝试在 codemagic.yaml 将 xcode 固定为稳定版)")
    end

    upload_to_testflight(
      api_key: api_key_params,
      ipa: "build/TimeTreehole.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

end
