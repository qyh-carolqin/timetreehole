# ============================================================
#  Fastlane 配置 — 时间树洞 iOS
#  自动管理证书 + 描述文件 + 构建 + TestFlight 上传
# ============================================================

require 'spaceship'

default_platform(:ios)

APP_IDENTIFIER = "com.carolqin.timetreehole"

# API Key 认证 (从环境变量读取)
# 注意: fastlane 的 api_key 哈希用 :key 承载 .p8 内容 (:key_content / :key_filepath 为兼容别名)
def api_key_params
  {
    key_id: ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key: ENV["APP_STORE_CONNECT_KEY"],
    key_content: ENV["APP_STORE_CONNECT_KEY"],
    # 普通 App Store 团队 (非企业版) — 不设置 cert 会无法判断团队类型而崩溃
    in_house: false
  }
end

# ------------------------------------------------------------
#  上传通道 (关键!)
# ------------------------------------------------------------
# fastlane 2.237 的 ItunesTransporter 有三个执行器, 选择逻辑见
# fastlane_core/lib/fastlane_core/itunes_transporter.rb:995
#
#   should_use_altool? = !use_shell_script
#                        && altool_compatible_command      # pilot 恒传 true
#                        && !Helper.user_defined_itms_path?
#                        && Helper.mac? && xcode_at_least?(14)
#
# Xcode 26 已经删掉了内嵌的 iTMSTransporter Java 套件
# (Contents/SharedFrameworks/ContentDeliveryServices.framework/.../itms),
# 所以 Java / ShellScript 两个执行器必然失败:
#   - JavaTransporterExecutor  → FileUtils.cd(Helper.itms_path) → 路径不存在
#   - ShellScriptTransporter   → Helper.transporter_path 同样依赖 itms_path
#
# 唯一可用的是 AltoolTransporterExecutor (xcrun altool), 而它的启用条件是
# 【这两个环境变量都不能设置】。之前设置它们反而把唯一的活路堵死了。
# 因此这里显式清空, 防止 CI 镜像预置了这些变量。
def force_altool_transporter!
  %w[
    FASTLANE_ITUNES_TRANSPORTER_PATH
    FASTLANE_ITUNES_TRANSPORTER_USE_SHELL_SCRIPT
  ].each do |var|
    UI.important("清除环境变量 #{var} (会导致 fastlane 放弃 altool 通道)") if ENV[var]
    ENV.delete(var)
  end
  UI.message("📤 上传通道: xcrun altool (Xcode 26 下唯一可用)")
end

# ------------------------------------------------------------
#  签名资产清理 (防止 Apple 证书配额被烧完)
# ------------------------------------------------------------
# Codemagic 的 keychain 每次构建都是全新的, 本地不存在私钥, 所以 `cert`
# 每跑一次就在 Apple 后台新建一张 Apple Distribution 证书。
# Apple 的发布证书上限是 3 张, 撞上限后 cert 步骤会直接失败。
#
# 这里在建证书之前, 先把本 App 的旧 App Store 描述文件和所有发布证书吊销,
# 保证每次构建都有配额, 同时让干净的 profile 名字 (不带时间戳) 被释放出来。
#
# 说明: 吊销发布证书不会影响已经上传到 TestFlight / App Store 的构建,
#       Apple 侧会重新签名。设置 SKIP_SIGNING_CLEANUP=1 可跳过本步骤。
def cleanup_signing_assets!
  if ENV["SKIP_SIGNING_CLEANUP"].to_s == "1"
    UI.important("⏭  已设置 SKIP_SIGNING_CLEANUP=1, 跳过签名资产清理")
    return
  end

  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV["APP_STORE_CONNECT_KEY_IDENTIFIER"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key: ENV["APP_STORE_CONNECT_KEY"],
    in_house: false
  )

  # 1) 先删描述文件 (它引用证书, 先删更干净)
  profiles = Spaceship::ConnectAPI::Profile.all(
    filter: { profileType: Spaceship::ConnectAPI::Profile::ProfileType::IOS_APP_STORE }
  )
  stale_profiles = profiles.select { |p| p.name.to_s.start_with?(APP_IDENTIFIER) }
  if stale_profiles.empty?
    UI.message("🧹 无历史 App Store 描述文件")
  else
    stale_profiles.each do |p|
      p.delete!
      UI.message("🧹 已删除描述文件: #{p.name}")
    end
  end

  # 2) 再吊销发布证书 (本地无私钥, 留着也用不了, 只会占配额)
  dist_types = [
    Spaceship::ConnectAPI::Certificate::CertificateType::DISTRIBUTION,
    Spaceship::ConnectAPI::Certificate::CertificateType::IOS_DISTRIBUTION
  ]
  dist_certs = Spaceship::ConnectAPI::Certificate.all.select do |c|
    dist_types.include?(c.certificate_type)
  end
  if dist_certs.empty?
    UI.message("🧹 无历史发布证书")
  else
    dist_certs.each do |c|
      c.delete!
      UI.message("🧹 已吊销发布证书: #{c.id} (#{c.display_name})")
    end
  end

  UI.success("✅ 签名资产清理完成, 证书配额已释放")
rescue => e
  # 清理失败不应该阻断构建 — 万一 API 变了, 让 cert 自己去撞
  UI.important("⚠️ 签名资产清理失败 (忽略继续): #{e.message}")
end

platform :ios do

  desc "构建并上传 TestFlight"
  lane :beta do
    force_altool_transporter!

    # 0. 清理历史签名资产, 释放 Apple 证书配额
    cleanup_signing_assets!

    # 1. 创建/获取 Apple Distribution 证书
    cert(
      development: false,
      platform: "ios",
      api_key: api_key_params
    )

    # 2. 创建/获取 App Store 描述文件 (默认即 App Store 发布描述文件, 不传 adhoc/development)
    sigh(
      force: true,
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      api_key: api_key_params
    )

    # 2.5 把 sigh 真实生成的 profile 名写回 Xcode 工程
    #     解决: project.yml 里写死的 PROVISIONING_PROFILE_SPECIFIER 与 sigh 实际
    #     生成的名字不一致导致 gym archive 报 "No profile ... found"。
    #     用 SIGH_NAME 环境变量(由 sigh 设置)动态覆盖 Release 配置的 specifier。
    update_code_signing_settings(
      path: "TimeTreehole/TimeTreehole.xcodeproj",
      use_automatic_signing: false,
      profile_name: ENV["SIGH_NAME"],
      code_sign_identity: "Apple Distribution",
      targets: ["TimeTreehole"],
      build_configurations: ["Release"]
    )

    # 3. 编译构建
    gym(
      project: "TimeTreehole/TimeTreehole.xcodeproj",
      scheme: "TimeTreehole",
      configuration: "Release",
      export_method: "app-store",
      include_symbols: true,
      include_bitcode: false,
      output_directory: "build",
      output_name: "TimeTreehole.ipa",
      clean: true
    )

    # 4. 上传到 TestFlight (走 altool, 不要碰 transporter 环境变量)
    upload_to_testflight(
      api_key: api_key_params,
      ipa: "build/TimeTreehole.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

end
